{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "us.anthropic.claude-opus-4-6-v1",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude/hooks && uv run python notification.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude/hooks && uv run python stop.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude/hooks && uv run python pretooluse_notification.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-simple.sh"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "notion@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "$comment": "cleanupPeriodDays docs: https://code.claude.com/docs/en/settings ; schema: https://www.schemastore.org/claude-code-settings.json ; caveat: https://code.claude.com/docs/en/data-usage",
  "feedbackSurveyState": {
    "lastShownTime": 1754085632943
  }
}
