#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$script_dir/zone-channel-common"

usage() {
  cat <<'EOF'
Usage:
  zone-li-sample recent [zone-li-read recent args...]
  zone-li-sample thread --thread-url URL [zone-li-read thread args...]
  zone-li-sample thread --profile-url URL [zone-li-read thread args...]
  zone-li-sample profile --thread-url URL [zone-li-read profile args...]
  zone-li-sample profile --profile-url URL [zone-li-read profile args...]

Writes full LinkedIn validation samples under private
~/pro/lab/zone-channel-ingest/samples/linkedin-sourya/.
EOF
}

if [[ "$#" -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

cmd="$1"
shift
case "$cmd" in
  recent|thread|profile) ;;
  *)
    echo "Unknown LinkedIn sample command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac

stamp="$(zone_channel_slug_now)"
out="$ZONE_CHANNEL_LINKEDIN_SAMPLE_DIR/linkedin-$cmd-sample-$stamp.json"

zone_channel_ensure_dirs
zone_channel_linkedin_ensure_playwright
zone_channel_audit "sample" "linkedin" "$cmd" "$@"
zone_channel_linkedin_lock
zone_channel_linkedin_node "$ZONE_CHANNEL_LINKEDIN_EXTRACTOR" "$cmd" "$@" --output "$out" --quiet >/dev/null
chmod 600 "$out"
echo "$out"
