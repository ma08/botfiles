#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/codex-app-notify-common"
codex_app_load_env

: "${UV_BIN:?UV_BIN is not set. Check shell/10-uv-bin.sh.}"

pid_file="$(codex_app_state_path notify-proxy.pid)"
log_file="$(codex_app_state_path notify-proxy.log)"
event_log="$(codex_app_state_path events.jsonl)"
state_path="$(codex_app_state_path state.json)"
listen_url="ws://127.0.0.1:${CODEX_APP_NOTIFY_PROXY_PORT}"

if codex_app_port_listening "127.0.0.1" "$CODEX_APP_NOTIFY_PROXY_PORT"; then
  printf 'Codex app notify proxy already listening at %s\n' "$listen_url"
  exit 0
fi

if codex_app_pid_alive "$pid_file"; then
  printf 'Codex app notify proxy pid exists but port is closed: %s\n' "$pid_file" >&2
  exit 1
fi

dry_run_arg=()
case "${CODEX_APP_NOTIFY_DRY_RUN}" in
  1|true|TRUE|yes|YES|on|ON) dry_run_arg=(--dry-run) ;;
esac

codex_app_start_background \
  "codex-app-notify-proxy" \
  "$pid_file" \
  "$log_file" \
  "$UV_BIN" run --project "$BOTFILES_ROOT/claude/hooks" \
    python "$BOTFILES_ROOT/codex/hooks/codex_app_server_notify_proxy.py" \
    --listen "$listen_url" \
    --upstream "$CODEX_APP_NOTIFY_UPSTREAM" \
    --state-path "$state_path" \
    --event-log "$event_log" \
    "${dry_run_arg[@]}"

if codex_app_wait_for_log "Codex App Server notify proxy listening on $listen_url" "$log_file" "$pid_file"; then
  printf 'Started Codex app notify proxy at %s\n' "$listen_url"
  printf 'Upstream: %s\n' "$CODEX_APP_NOTIFY_UPSTREAM"
  printf 'Event log: %s\n' "$event_log"
  printf 'Process log: %s\n' "$log_file"
  exit 0
fi

printf 'Codex app notify proxy did not start. Log: %s\n' "$log_file" >&2
exit 1
