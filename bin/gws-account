#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: gws-account <alias> <gws args...>" >&2
  exit 64
fi

alias_name="$1"
shift

accounts_dir="${GWS_ACCOUNTS_DIR:-$HOME/.config/gws/accounts}"
credentials_file="$accounts_dir/$alias_name.json"
state_root="${GWS_ACCOUNT_STATE_DIR:-$HOME/.config/gws/account-state}"
state_dir="$state_root/$alias_name"
normalized_credentials="$state_dir/credentials.json"
client_secret_file="${HOME}/.config/gws/client_secret.json"

if [[ ! -f "$credentials_file" ]]; then
  echo "Missing credentials for alias '$alias_name': $credentials_file" >&2
  echo "Initialize the account first with:" >&2
  echo "  gws auth login --readonly --services gmail" >&2
  echo "  gws-save-account $alias_name" >&2
  exit 66
fi

mkdir -p "$state_dir"

python3 - "$credentials_file" "$normalized_credentials" <<'PY'
import json
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
dest = pathlib.Path(sys.argv[2])
data = json.loads(source.read_text())

# Normalize credential exports for file-based auth.
data.setdefault("token_uri", "https://oauth2.googleapis.com/token")

dest.write_text(json.dumps(data))
PY

chmod 600 "$normalized_credentials"

export GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE="$normalized_credentials"
export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$state_dir"

if [[ -z "${GOOGLE_WORKSPACE_PROJECT_ID:-}" && -f "$client_secret_file" ]]; then
  project_id="$(
    python3 - "$client_secret_file" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text())
for section in ("installed", "web"):
    if isinstance(data.get(section), dict) and data[section].get("project_id"):
        print(data[section]["project_id"])
        break
PY
  )"
  if [[ -n "$project_id" ]]; then
    export GOOGLE_WORKSPACE_PROJECT_ID="$project_id"
  fi
fi

exec gws "$@"
