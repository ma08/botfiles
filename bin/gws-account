#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: gws-account <alias> <gws args...>" >&2
  exit 64
fi

alias_name="$1"
shift

accounts_dir="${GWS_ACCOUNTS_DIR:-$HOME/.config/gws/accounts}"
credentials_file="$accounts_dir/$alias_name.json"
state_root="${GWS_ACCOUNT_STATE_DIR:-$HOME/.config/gws/account-state}"
state_dir="$state_root/$alias_name"
normalized_credentials="$state_dir/credentials.json"
token_cache="$state_dir/token_cache.json"
encrypted_credentials="$state_dir/credentials.enc"
credentials_fingerprint_file="$state_dir/credentials.sha256"
client_secret_file="${HOME}/.config/gws/client_secret.json"

if [[ ! -f "$credentials_file" ]]; then
  echo "Missing credentials for alias '$alias_name': $credentials_file" >&2
  echo "Initialize the account first with:" >&2
  echo "  gws auth login --scopes https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose" >&2
  echo "  gws-save-account $alias_name" >&2
  exit 66
fi

mkdir -p "$state_dir"
chmod 700 "$state_dir"

python3 - "$credentials_file" "$normalized_credentials" <<'PY'
import json
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
dest = pathlib.Path(sys.argv[2])
data = json.loads(source.read_text())

# Normalize credential exports for file-based auth.
data.setdefault("token_uri", "https://oauth2.googleapis.com/token")

dest.write_text(json.dumps(data))
PY

chmod 600 "$normalized_credentials"

credentials_fingerprint="$(
  python3 - "$credentials_file" <<'PY'
import hashlib
import pathlib
import sys

print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
)"
stored_credentials_fingerprint=""
if [[ -f "$credentials_fingerprint_file" ]]; then
  IFS= read -r stored_credentials_fingerprint < "$credentials_fingerprint_file" || true
fi

if [[ "$stored_credentials_fingerprint" != "$credentials_fingerprint" ]]; then
  # Both files are derived authentication state. Discard them whenever the
  # authoritative named-account credential changes, including after rollback.
  rm -f "$token_cache" "$encrypted_credentials"
  fingerprint_tmp="$state_dir/.credentials.sha256.$$"
  (
    umask 077
    printf '%s\n' "$credentials_fingerprint" > "$fingerprint_tmp"
    chmod 600 "$fingerprint_tmp"
    mv -f "$fingerprint_tmp" "$credentials_fingerprint_file"
  )
fi

export GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE="$normalized_credentials"
export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$state_dir"
if [[ -z "${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:-}" ]]; then
  # Named aliases are designed for non-interactive agent and SSH use. macOS
  # keychain access can fail in those sessions when a refreshed access token
  # must be cached, so keep the derived cache private and file-backed by
  # default. Operators can still override this explicitly.
  export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND="${GWS_ACCOUNT_KEYRING_BACKEND:-file}"
fi

if [[ -z "${GOOGLE_WORKSPACE_PROJECT_ID:-}" && -f "$client_secret_file" ]]; then
  project_id="$(
    python3 - "$client_secret_file" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text())
for section in ("installed", "web"):
    if isinstance(data.get(section), dict) and data[section].get("project_id"):
        print(data[section]["project_id"])
        break
PY
  )"
  if [[ -n "$project_id" ]]; then
    export GOOGLE_WORKSPACE_PROJECT_ID="$project_id"
  fi
fi

exec gws "$@"
