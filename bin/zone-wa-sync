#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$script_dir/zone-channel-common"

zone_channel_ensure_dirs
zone_channel_require_cmd wacli
zone_channel_check_cap

if [[ "$#" -eq 0 ]]; then
  set -- sync --once --idle-exit 30s --download-media --refresh-contacts --refresh-groups
elif [[ "${1:-}" != "sync" ]]; then
  set -- sync "$@"
fi

zone_channel_sync_audit "whatsapp" "start" "$@"

WACLI_STORE_DIR="$ZONE_CHANNEL_WACLI_STORE" \
WACLI_SYNC_MAX_DB_SIZE="$ZONE_CHANNEL_WACLI_MAX_DB_SIZE" \
  wacli --store "$ZONE_CHANNEL_WACLI_STORE" "$@"

zone_channel_check_cap
zone_channel_sync_audit "whatsapp" "finished" "$@"
