#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$script_dir/channel-common"

zone_channel_route_if_needed "linkedin" "$@"

usage() {
  cat <<'EOF'
Usage:
  channel-linkedin-read recent [--limit 20] [--open-limit 10] [--max-messages 50]
  channel-linkedin-read thread --thread-url URL [--max-messages 50]
  channel-linkedin-read thread --profile-url URL [--max-messages 50]
  channel-linkedin-read thread --name NAME [--max-messages 50]
  channel-linkedin-read profile --thread-url URL [--experience-limit 3]
  channel-linkedin-read profile --profile-url URL [--experience-limit 3]

Runs bounded, read-only LinkedIn message discovery through the dedicated VM
Chrome profile. No send/connect/react/archive/delete actions are implemented.
Raw output is printed to stdout; save full samples with channel-linkedin-sample.
EOF
}

if [[ "$#" -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

case "$1" in
  recent|thread|profile|health) ;;
  *)
    echo "Unknown LinkedIn read command: $1" >&2
    usage >&2
    exit 2
    ;;
esac

zone_channel_ensure_dirs
zone_channel_linkedin_ensure_playwright
zone_channel_audit "query" "linkedin" "$@"
zone_channel_linkedin_lock
zone_channel_linkedin_node "$ZONE_CHANNEL_LINKEDIN_EXTRACTOR" "$@"
