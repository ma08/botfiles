#!/usr/bin/env python3
"""Create a Gmail draft through a named gws account alias; never send it."""

from __future__ import annotations

import argparse
import base64
import json
import mimetypes
import os
import shutil
import stat
import subprocess
import sys
from email.message import EmailMessage
from email.utils import formataddr, getaddresses
from html.parser import HTMLParser
from pathlib import Path
from typing import ClassVar
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode, urlparse
from urllib.request import Request, urlopen

ACCOUNT_ADDRESSES = {
    "work": "sourya4@trymyzone.com",
    "personal": "sourya4@gmail.com",
    "columbia": "sourya.kakarla@columbia.edu",
}

GMAIL_COMPOSE_SCOPE = "https://www.googleapis.com/auth/gmail.compose"
AUTH_SCOPES = (
    "https://www.googleapis.com/auth/drive.readonly,"
    "https://www.googleapis.com/auth/gmail.readonly,"
    f"{GMAIL_COMPOSE_SCOPE}"
)
GMAIL_DRAFTS_URL = "https://gmail.googleapis.com/gmail/v1/users/me/drafts"
ALLOWED_TOKEN_HOSTS = {"accounts.google.com", "oauth2.googleapis.com"}


class DraftCreationError(RuntimeError):
    """A safe-to-report failure while obtaining auth or creating a draft."""


class _HTMLTextExtractor(HTMLParser):
    """Produce a basic plain-text fallback for an HTML draft body."""

    BREAK_TAGS: ClassVar[set[str]] = {"br", "div", "li", "p", "tr"}

    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        del attrs
        if tag.lower() in self.BREAK_TAGS and self.parts:
            self.parts.append("\n")

    def handle_endtag(self, tag: str) -> None:
        if tag.lower() in self.BREAK_TAGS:
            self.parts.append("\n")

    def handle_data(self, data: str) -> None:
        self.parts.append(data)

    def text(self) -> str:
        lines = (" ".join(line.split()) for line in "".join(self.parts).splitlines())
        return "\n".join(line for line in lines if line).strip()


def _safe_header(value: str, field: str) -> str:
    if "\r" in value or "\n" in value:
        raise ValueError(f"{field} cannot contain line breaks")
    return value.strip()


def _addresses(values: list[str] | None, field: str) -> list[str]:
    raw_values = [_safe_header(value, field) for value in values or []]
    addresses: list[str] = []
    for display_name, address in getaddresses(raw_values):
        display_name = _safe_header(display_name, field)
        address = _safe_header(address, field)
        if not address:
            raise ValueError(f"{field} contains an invalid recipient")
        addresses.append(formataddr((display_name, address)) if display_name else address)
    return addresses


def _compose_scope_available(account: str) -> bool:
    result = subprocess.run(
        ["gws-account", account, "auth", "status"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(
            f"gws-gmail-draft: could not verify OAuth scopes for {account} "
            f"(exit {result.returncode})",
            file=sys.stderr,
        )
        if result.stderr:
            print(result.stderr.rstrip(), file=sys.stderr)
        return False

    try:
        status = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("gws-gmail-draft: gws auth status returned non-JSON output", file=sys.stderr)
        return False

    if GMAIL_COMPOSE_SCOPE in status.get("scopes", []):
        return True

    print(
        f"gws-gmail-draft: {account} is missing the required gmail.compose scope. "
        "Reauthorize with:",
        file=sys.stderr,
    )
    print(
        f"  gws-account {account} auth login --scopes {AUTH_SCOPES}",
        file=sys.stderr,
    )
    return False


def _credential_path(account: str) -> Path:
    accounts_dir = Path(
        os.environ.get(
            "GWS_ACCOUNTS_DIR",
            Path.home() / ".config" / "gws" / "accounts",
        )
    )
    return accounts_dir / f"{account}.json"


def _load_credentials(account: str) -> dict[str, str]:
    path = _credential_path(account)
    try:
        mode = stat.S_IMODE(path.stat().st_mode)
        if mode & 0o077:
            raise DraftCreationError(
                f"credential file permissions are too broad ({mode:04o}); expected 0600: {path}"
            )
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise DraftCreationError(f"credential file not found: {path}") from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise DraftCreationError(f"could not read credential file: {path}") from exc

    payload.setdefault("token_uri", "https://oauth2.googleapis.com/token")
    required = ("client_id", "client_secret", "refresh_token", "token_uri")
    missing = [field for field in required if not payload.get(field)]
    if missing:
        raise DraftCreationError(
            f"credential file is missing required fields: {', '.join(missing)}"
        )
    return {field: str(payload[field]) for field in required}


def _access_token(account: str) -> str:
    credentials = _load_credentials(account)
    token_uri = credentials["token_uri"]
    parsed_uri = urlparse(token_uri)
    if parsed_uri.scheme != "https" or parsed_uri.hostname not in ALLOWED_TOKEN_HOSTS:
        raise DraftCreationError("credential token_uri is not an approved Google HTTPS endpoint")

    request = Request(
        token_uri,
        data=urlencode(
            {
                "client_id": credentials["client_id"],
                "client_secret": credentials["client_secret"],
                "refresh_token": credentials["refresh_token"],
                "grant_type": "refresh_token",
            }
        ).encode("ascii"),
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urlopen(request, timeout=30) as response:
            payload = json.loads(response.read())
    except HTTPError as exc:
        raise DraftCreationError(f"OAuth token refresh failed (HTTP {exc.code})") from exc
    except (URLError, TimeoutError, json.JSONDecodeError) as exc:
        raise DraftCreationError("OAuth token refresh failed") from exc

    access_token = payload.get("access_token")
    if not access_token:
        raise DraftCreationError("OAuth token refresh returned no access token")
    return str(access_token)


def _gmail_create_draft(
    access_token: str,
    raw: str,
    *,
    opener=urlopen,
) -> dict[str, object]:
    request = Request(
        GMAIL_DRAFTS_URL,
        data=json.dumps({"message": {"raw": raw}}, separators=(",", ":")).encode(
            "utf-8"
        ),
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": "gws-gmail-draft/1",
        },
        method="POST",
    )
    try:
        with opener(request, timeout=60) as response:
            return json.loads(response.read())
    except HTTPError as exc:
        raise DraftCreationError(f"Gmail draft creation failed (HTTP {exc.code})") from exc
    except (URLError, TimeoutError, json.JSONDecodeError) as exc:
        raise DraftCreationError("Gmail draft creation failed") from exc


def _body(args: argparse.Namespace) -> str:
    if args.body is not None:
        return args.body
    return args.body_file.read_text(encoding="utf-8")


def _plain_fallback(html_body: str) -> str:
    extractor = _HTMLTextExtractor()
    extractor.feed(html_body)
    return extractor.text() or "HTML email draft"


def _build_message(args: argparse.Namespace) -> tuple[EmailMessage, dict[str, object]]:
    sender = _safe_header(args.from_address or ACCOUNT_ADDRESSES[args.account], "From")
    subject = _safe_header(args.subject, "Subject")
    to = _addresses(args.to, "To")
    cc = _addresses(args.cc, "Cc")
    bcc = _addresses(args.bcc, "Bcc")
    body = _body(args)

    message = EmailMessage()
    message["From"] = sender
    if to:
        message["To"] = ", ".join(to)
    if cc:
        message["Cc"] = ", ".join(cc)
    if bcc:
        message["Bcc"] = ", ".join(bcc)
    message["Subject"] = subject

    if args.html:
        message.set_content(_plain_fallback(body))
        message.add_alternative(body, subtype="html")
    else:
        message.set_content(body)

    attachment_summaries: list[dict[str, object]] = []
    for attachment in args.attach:
        if not attachment.is_file():
            raise FileNotFoundError(f"Attachment not found: {attachment}")
        content_type, _ = mimetypes.guess_type(attachment.name)
        content_type = content_type or "application/octet-stream"
        maintype, subtype = content_type.split("/", 1)
        payload = attachment.read_bytes()
        message.add_attachment(
            payload,
            maintype=maintype,
            subtype=subtype,
            filename=attachment.name,
        )
        attachment_summaries.append(
            {
                "name": attachment.name,
                "contentType": content_type,
                "sizeBytes": len(payload),
            }
        )

    summary: dict[str, object] = {
        "account": args.account,
        "from": sender,
        "to": to,
        "cc": cc,
        "bccCount": len(bcc),
        "subject": subject,
        "bodyKind": "html" if args.html else "text",
        "bodyBytes": len(body.encode("utf-8")),
        "attachments": attachment_summaries,
        "gmailMethod": "users.drafts.create",
        "willSend": False,
    }
    return message, summary


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Create an unsent Gmail draft through a named gws account alias."
    )
    parser.add_argument("account", choices=sorted(ACCOUNT_ADDRESSES))
    parser.add_argument("--to", action="append", help="Recipient(s), repeatable or comma-separated")
    parser.add_argument("--cc", action="append", help="CC recipient(s), repeatable or comma-separated")
    parser.add_argument("--bcc", action="append", help="BCC recipient(s), repeatable or comma-separated")
    parser.add_argument("--subject", required=True)
    body_group = parser.add_mutually_exclusive_group(required=True)
    body_group.add_argument("--body", help="Inline body text")
    body_group.add_argument("--body-file", type=Path, help="UTF-8 body file")
    parser.add_argument("--html", action="store_true", help="Treat the body as HTML")
    parser.add_argument("--attach", action="append", type=Path, default=[], help="Attachment path")
    parser.add_argument("--from-address", help="Configured Gmail send-as address")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Build and validate locally, then print a safe summary without calling Gmail",
    )
    return parser


def main() -> int:
    args = _parser().parse_args()
    try:
        message, summary = _build_message(args)
    except (OSError, UnicodeError, ValueError) as exc:
        print(f"gws-gmail-draft: {exc}", file=sys.stderr)
        return 2

    if args.dry_run:
        print(json.dumps({"status": "dry_run", **summary}, indent=2))
        return 0

    if shutil.which("gws-account") is None:
        print("gws-gmail-draft: gws-account is not on PATH", file=sys.stderr)
        return 127

    if not _compose_scope_available(args.account):
        return 77

    try:
        raw = base64.urlsafe_b64encode(message.as_bytes()).decode("ascii").rstrip("=")
        response = _gmail_create_draft(_access_token(args.account), raw)
    except DraftCreationError as exc:
        print(f"gws-gmail-draft: {exc}", file=sys.stderr)
        return 1

    print(
        json.dumps(
            {
                "status": "draft_created",
                **summary,
                "draftId": response.get("id"),
                "messageId": response.get("message", {}).get("id"),
                "threadId": response.get("message", {}).get("threadId"),
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
