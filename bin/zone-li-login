#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$script_dir/zone-channel-common"

usage() {
  cat <<'EOF'
Usage:
  zone-li-login [linkedin-url]

Opens LinkedIn in a dedicated VM Chrome profile for human login. Credentials are
entered by the human in the browser, never by this wrapper.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ -z "${DISPLAY:-}" ]]; then
  echo "DISPLAY is not set. Open a VM GUI/remote desktop terminal and rerun zone-li-login." >&2
  exit 2
fi

url="${1:-https://www.linkedin.com/messaging/}"

zone_channel_ensure_dirs
zone_channel_require_cmd "$ZONE_CHANNEL_LINKEDIN_CHROME_BIN"
zone_channel_linkedin_lock
zone_channel_audit "login" "linkedin" "$url"

echo "LinkedIn Chrome profile: $ZONE_CHANNEL_LINKEDIN_CHROME_PROFILE"
echo "Opening: $url"

exec "$ZONE_CHANNEL_LINKEDIN_CHROME_BIN" \
  --user-data-dir="$ZONE_CHANNEL_LINKEDIN_CHROME_PROFILE" \
  --no-first-run \
  --no-default-browser-check \
  --new-window \
  "$url"
