#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOTFILES_ROOT="${BOTFILES_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

if [ -f "$BOTFILES_ROOT/.botenv" ]; then
  # shellcheck disable=SC1090
  source "$BOTFILES_ROOT/.botenv"
fi

# Reuse the existing host-selection defaults and validation helpers that back
# the interactive `work-*` commands.
# shellcheck disable=SC1090
source "$BOTFILES_ROOT/shell/20-ssh-workflows.sh"

usage() {
  cat <<'EOF'
Usage:
  start-zellij-session-for-task [--target here|ml|arya|agent] [--project-root <path>] [--session-name <name>] [--tab-name <name>] [--dry-run] <linear-url|linear-id|github-issue-url|task description>

Starts a detached zellij session and bootstraps Codex with:
  $start-new-task <original input>

Notes:
  - Default target is `here` (the current machine).
  - Remote targets reuse the same host selection defaults as `work-ml`, `work-arya`, and `work-agent`.
  - Uses `codex --dangerously-bypass-approvals-and-sandbox`, the current CLI equivalent of the older `--yolo` shorthand.
EOF
}

die() {
  printf 'start-zellij-session-for-task: %s\n' "$*" >&2
  exit 1
}

field_from_resolve_output() {
  local key="$1"
  local output="$2"
  local line

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$key":\ *)
        printf '%s\n' "${line#"$key: "}"
        return 0
        ;;
    esac
  done <<<"$output"

  return 1
}

build_cd_command() {
  local path="$1"

  if [ "$path" = "$HOME" ]; then
    printf 'cd "${HOME}"'
    return 0
  fi

  if [[ "$path" == "$HOME/"* ]]; then
    printf 'cd "${HOME}/%s"' "${path#"$HOME/"}"
    return 0
  fi

  printf 'cd %q' "$path"
}

build_codex_command() {
  local prompt="$1"
  printf 'exec codex --profile openai_api --dangerously-bypass-approvals-and-sandbox --no-alt-screen %q' "$prompt"
}

build_bootstrap_script() {
  local project_root="$1"
  local prompt="$2"
  printf '%s && %s' "$(build_cd_command "$project_root")" "$(build_codex_command "$prompt")"
}

build_launch_script() {
  local session_name="$1"
  local tab_name="$2"
  local bootstrap_script="$3"
  local attach_cmd
  local rename_cmd
  local run_cmd

  printf -v attach_cmd 'zellij attach --create-background %q >/dev/null' "$session_name"
  printf -v rename_cmd 'zellij -s %q action rename-tab %q >/dev/null 2>&1 || true' "$session_name" "$tab_name"
  printf -v run_cmd 'zellij -s %q run --in-place -- bash -lc %q' "$session_name" "$bootstrap_script"

  printf 'set -euo pipefail\n%s\nsleep 1\n%s\n%s\n' "$attach_cmd" "$rename_cmd" "$run_cmd"
}

session_exists_local() {
  local session_name="$1"

  zellij list-sessions --reverse --no-formatting 2>/dev/null \
    | sed '/^No active zellij sessions found\.?$/d' \
    | sed 's/ \[Created.*$//' \
    | grep -Fxq "$session_name"
}

session_exists_remote() {
  local host="$1"
  local session_name="$2"

  ssh -o BatchMode=yes -o ConnectTimeout=8 "$host" \
    "zellij list-sessions --reverse --no-formatting 2>/dev/null | sed '/^No active zellij sessions found\\.?$/d' | sed 's/ \\[Created.*$//'" \
    | grep -Fxq "$session_name"
}

build_zellij_link() {
  local session_name="$1"

  if [ "${ZELLIJ_WEB_ENABLE_LINKS:-false}" != "true" ] || [ -z "${ZELLIJ_WEB_BASE_URL:-}" ]; then
    printf 'none\n'
    return 0
  fi

  python - "$session_name" "${ZELLIJ_WEB_BASE_URL%/}" <<'PY'
import sys
from urllib.parse import quote

session_name = sys.argv[1]
base_url = sys.argv[2]
print(f"{base_url}/{quote(session_name, safe='')}")
PY
}

resolve_target_host() {
  local target="$1"

  case "$target" in
    here|local|current)
      printf 'local\n'
      ;;
    ml)
      _bot_ssh_pick_reachable_host "$BOT_ML_HOST_PRIMARY" "$BOT_ML_HOST_FALLBACK"
      ;;
    arya)
      _bot_ssh_pick_reachable_host "$BOT_ARYA_HOST"
      ;;
    agent)
      _bot_ssh_pick_reachable_host "$BOT_AGENT_HOST_PRIMARY" "$BOT_AGENT_HOST_FALLBACK"
      ;;
    *)
      return 1
      ;;
  esac
}

attach_hint_for_target() {
  local target="$1"
  local session_name="$2"

  case "$target" in
    here|local|current)
      printf 'zellij attach %s\n' "$session_name"
      ;;
    ml)
      printf 'work-ml %s\n' "$session_name"
      ;;
    arya)
      printf 'work-arya %s\n' "$session_name"
      ;;
    agent)
      printf 'work-agent %s\n' "$session_name"
      ;;
    *)
      printf 'zellij attach %s\n' "$session_name"
      ;;
  esac
}

target="here"
project_root="$PWD"
session_name_override=""
tab_name_override=""
dry_run=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      target="${2:-}"
      shift 2
      ;;
    --project-root)
      project_root="${2:-}"
      shift 2
      ;;
    --session-name)
      session_name_override="${2:-}"
      shift 2
      ;;
    --tab-name)
      tab_name_override="${2:-}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage >&2
      die "unknown argument: $1"
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -gt 0 ] || {
  usage >&2
  die "task description or tracker reference is required"
}

description="$*"

project_root_abs="$(cd "$project_root" && pwd -P)"
resolve_output="$(
  python "$BOTFILES_ROOT/codex/skills/_shared/task_status/scripts/resolve_task_context.py" \
    --project-root "$project_root_abs" \
    --description "$description" \
    --max-slug-length 60
)"

task_slug="$(field_from_resolve_output "Task Slug" "$resolve_output")"
tracker_kind="$(field_from_resolve_output "Tracker Kind" "$resolve_output")"
tracker_url="$(field_from_resolve_output "Tracker URL" "$resolve_output")"
tracker_human_id="$(field_from_resolve_output "Tracker Human ID" "$resolve_output")"
canonical_project_root="$(field_from_resolve_output "Canonical Project Root" "$resolve_output")"

[ "$canonical_project_root" != "none" ] || die "could not resolve a canonical project root for this task"

session_name="${session_name_override:-$task_slug}"
_bot_ssh_validate_session_name "$session_name" || die "invalid session name: $session_name"

if [ -n "$tab_name_override" ]; then
  tab_name="$tab_name_override"
elif [ "$tracker_human_id" != "none" ]; then
  tab_name="[$tracker_human_id]"
else
  tab_name="$session_name"
fi

prompt="\$start-new-task $description"
bootstrap_script="$(build_bootstrap_script "$canonical_project_root" "$prompt")"
launch_script="$(build_launch_script "$session_name" "$tab_name" "$bootstrap_script")"
attach_hint="$(attach_hint_for_target "$target" "$session_name")"

resolved_host="$(resolve_target_host "$target")" || die "unsupported or unreachable target: $target"

if [ "$target" = "here" ] || [ "$resolved_host" = "local" ]; then
  command -v zellij >/dev/null 2>&1 || die "zellij is required on the current machine"
  if session_exists_local "$session_name"; then
    die "session already exists: $session_name (attach with: $attach_hint)"
  fi
else
  case "$canonical_project_root" in
    "$HOME"|"$HOME"/*)
      ;;
    *)
      die "remote targets require the resolved project root to live under \$HOME so the path stays portable across machines"
      ;;
  esac
  if session_exists_remote "$resolved_host" "$session_name"; then
    die "session already exists on $resolved_host: $session_name (attach with: $attach_hint)"
  fi
fi

if [ "$dry_run" -eq 1 ]; then
  printf 'Target: %s\n' "$target"
  printf 'Resolved Host: %s\n' "$resolved_host"
  printf 'Session Name: %s\n' "$session_name"
  printf 'Tab Name: %s\n' "$tab_name"
  printf 'Tracker Kind: %s\n' "$tracker_kind"
  printf 'Tracker URL: %s\n' "$tracker_url"
  printf 'Canonical Project Root: %s\n' "$canonical_project_root"
  printf 'Prompt: %s\n' "$prompt"
  printf 'Attach Hint: %s\n' "$attach_hint"
  printf 'Launch Script:\n%s' "$launch_script"
  exit 0
fi

if [ "$target" = "here" ] || [ "$resolved_host" = "local" ]; then
  bash -lc "$launch_script"
  zellij_link="$(build_zellij_link "$session_name")"
  printf 'Started detached task session.\n'
  printf 'Target: %s\n' "$target"
  printf 'Session: %s\n' "$session_name"
  printf 'Tab: %s\n' "$tab_name"
  printf 'Tracker: %s\n' "$tracker_url"
  printf 'Project Root: %s\n' "$canonical_project_root"
  printf 'Attach: %s\n' "$attach_hint"
  printf 'Zellij Link: %s\n' "$zellij_link"
  exit 0
fi

ssh -o BatchMode=yes -o ConnectTimeout=8 "$resolved_host" "bash -lc $(printf %q "$launch_script")"
printf 'Started detached task session.\n'
printf 'Target: %s\n' "$target"
printf 'Resolved Host: %s\n' "$resolved_host"
printf 'Session: %s\n' "$session_name"
printf 'Tab: %s\n' "$tab_name"
printf 'Tracker: %s\n' "$tracker_url"
printf 'Project Root: %s\n' "$canonical_project_root"
printf 'Attach: %s\n' "$attach_hint"
printf 'Zellij Link: remote-machine-local\n'
