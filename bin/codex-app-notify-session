#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/codex-app-notify-common"
codex_app_load_env

"$SCRIPT_DIR/codex-app-notify-start" >/dev/null

remote_url="ws://127.0.0.1:${CODEX_APP_NOTIFY_PROXY_PORT}"

case "${1:-}" in
  resume|fork)
    subcommand="$1"
    shift
    exec codex "$subcommand" --remote "$remote_url" "$@"
    ;;
  *)
    exec codex --remote "$remote_url" "$@"
    ;;
esac
