# Python cache files
**/__pycache__/

# Centralized secrets (runtime files are local-only and never committed)
secrets/*
!secrets/README.md
!secrets/templates/
!secrets/templates/**
secrets/local/

# Legacy secret paths kept ignored for migration safety
claude/hooks/.env
claude/.bedrock_claude_config_rc
claude/.vertex_claude_config_rc
opencode/.azure_codex_config_rc
claude/.bedrock_claude_env_secrets

# Claude hooks - generated files
claude/hooks/.venv/
claude/hooks/__pycache__/
claude/hooks/*.py[oc]
claude/hooks/hooks.log

# Codex secrets
codex/.azure_codex_config_rc
codex/.openai_codex_config_rc

# Codex system skills are machine-managed and can differ by OS/Codex version
codex/skills/.system/

# Codex app-managed runtime skills can differ by product surface and OS
codex/skills/chronicle/
codex/skills/hatch-pet/

# OS files
.DS_Store
*.swp
excalidraw.log
codex/config.toml.bak*
codex/config.toml.secrets*
codex/config.toml.vmback*

# Hermes curator/runtime state is generated locally
hermes/skills/.bundled_manifest
hermes/skills/.curator_backups/
hermes/skills/.curator_state
hermes/skills/.usage.json
hermes/skills/.usage.json.lock
