# Azure OpenAI for Codex + Oracle + Azure-backed deep research
export AZURE_OPENAI_API_KEY="replace_with_your_azure_openai_api_key"

# Optional Oracle Azure route. When endpoint + deployment are set, the local
# oracle wrapper uses this Azure deployment by default for API-mode runs.
export ORACLE_AZURE_OPENAI_ENDPOINT="https://ladduu-dev-openai.openai.azure.com/"
export ORACLE_AZURE_OPENAI_DEPLOYMENT="gpt-5.4-pro"
# Optional only if your Oracle client needs an explicit Azure inference API version.
# export ORACLE_AZURE_OPENAI_API_VERSION="2024-10-21"

# Optional Azure route for the OpenAI deep-research runner. Use a dedicated key
# when the deep-research deployment lives on a different Azure OpenAI resource.
export AZURE_OPENAI_DEEP_RESEARCH_ENDPOINT="https://ladduu-dev-openai-west-us.openai.azure.com/"
export AZURE_OPENAI_DEEP_RESEARCH_API_KEY="replace_with_your_west_us_azure_openai_api_key"
export AZURE_OPENAI_DEEP_RESEARCH_DEPLOYMENTS="o3-deep-research"
