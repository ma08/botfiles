# WhatsApp notifications for Claude/Codex hooks
export WHATSAPP_ENABLED=true
export WHATSAPP_TOKEN="replace_with_whatsapp_cloud_api_token"
export PHONE_NUMBER_ID="replace_with_phone_number_id"
export NOTIFY_PHONE_NUMBER="+1234567890"
# Optional override only for notifications. Preferred global location:
# secrets/local/machine.rc -> SYSTEM_NAME

# Gmail email notifications for Claude/Codex hooks
export EMAIL_ENABLED=false
export EMAIL_PROVIDER="gmail"
export EMAIL_TO="replace_with_destination_email@example.com"
# Optional. Usually leave empty and Gmail will use the authenticated profile.
export EMAIL_FROM=""
export EMAIL_SUBJECT_PREFIX="AgentAlert"
# Optional task override. Leave empty for automatic task label detection.
export EMAIL_TASK_LABEL=""

# OAuth client secret JSON downloaded from Google Cloud Console.
export GMAIL_OAUTH_CLIENT_SECRET_PATH="$HOME/pro/botfiles/secrets/local/client_secret_xxx.apps.googleusercontent.com.json"
# Local token cache produced after one-time OAuth bootstrap (must remain untracked).
export GMAIL_OAUTH_TOKEN_PATH="$HOME/pro/botfiles/secrets/local/gmail-token.json"
# Local Gmail thread state cache (must remain untracked).
export GMAIL_THREAD_STATE_PATH="$HOME/pro/botfiles/secrets/local/gmail-thread-state.json"
