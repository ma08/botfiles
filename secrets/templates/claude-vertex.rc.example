# GCP Vertex AI for Claude Code
# Docs: https://code.claude.com/docs/en/google-vertex
export CLAUDE_CODE_USE_VERTEX=1
export CLOUD_ML_REGION=global
export ANTHROPIC_VERTEX_PROJECT_ID="replace_with_your_gcp_project_id"

