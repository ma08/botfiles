# Optional direct provider keys for the deep-research skill.
#
# Azure OpenAI deep-research settings live in codex-azure.rc and are the
# preferred OpenAI-compatible route.

# Gemini Deep Research via Gemini Interactions API.
export GEMINI_API_KEY="replace_with_your_gemini_api_key"

# Exa Research API via exa-py.
export EXA_API_KEY="replace_with_your_exa_api_key"

# Direct OpenAI deep research is disabled by default to avoid accidental
# out-of-pocket direct OpenAI billing. Only enable when direct OpenAI spend is
# intentional and OPENAI_API_KEY is configured.
# export OPENAI_DEEP_RESEARCH_ALLOW_DIRECT="1"
