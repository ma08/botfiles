# Zotero MCP machine-local environment.
#
# Linux/GCP uses Web API mode and requires the three values below.
# macOS selects local Zotero mode automatically; Web API credentials are
# optional there unless explicitly setting ZOTERO_MCP_MODE=web.
export ZOTERO_API_KEY="replace_with_zotero_api_key"
export ZOTERO_LIBRARY_ID="replace_with_zotero_user_or_group_id"
export ZOTERO_LIBRARY_TYPE="user"

# Optional routing and executable overrides:
# export ZOTERO_MCP_MODE="auto"  # auto | local | web
# export ZOTERO_MCP_SERVER_BIN="$HOME/.local/bin/zotero-mcp"
