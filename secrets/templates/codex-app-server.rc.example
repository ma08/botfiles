# Codex App Server request_user_input notification proxy defaults
#
# This file is optional. Defaults are loopback-only and safe for VM-local use.
export CODEX_APP_SERVER_PORT=17370
export CODEX_APP_NOTIFY_PROXY_SCOPE=session
export CODEX_APP_NOTIFY_UPSTREAM="ws://127.0.0.1:${CODEX_APP_SERVER_PORT}"

# Optional global app-server state base. Proxy state is derived from this under
# session scope, while app-server pid/logs stay global. CODEX_APP_NOTIFY_STATE_DIR
# is still accepted as a legacy alias and is normalized back to this base.
# export CODEX_APP_NOTIFY_BASE_STATE_DIR="$HOME/.cache/botfiles/codex-app-server-notify"
#
# Leave these unset for the default per-zellij-session proxy port and state.
# Set CODEX_APP_NOTIFY_PROXY_SCOPE=global/shared when intentionally using one
# shared/static proxy.
# export CODEX_APP_NOTIFY_PROXY_PORT=17371
# export CODEX_APP_NOTIFY_PROXY_STATE_DIR="$HOME/.cache/botfiles/codex-app-server-notify"

# Legacy convenience aliases (`codex-azure`, `codexy-azure`, etc.) use the
# App Server notification path by default. Set false to make those aliases use
# raw `codex` while keeping the explicit `codexn*` aliases available.
export CODEX_APP_NOTIFY_DEFAULT=true

# Set true for hands-on testing without WhatsApp/Gmail sends.
export CODEX_APP_NOTIFY_DRY_RUN=false
